# =============================================
# GateGuard Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# App
NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gateguard_db
DB_USER=postgres
DB_PASSWORD=yourpasswordhere
DB_MAX_CONNECTIONS=20

# --- Optional: route shard_* member / personvisit tables to separate Postgres hosts ---
# When true, shard table reads/writes use SHARD_* below; main DB still holds canonical
# `member` (SERIAL) and `personvisit` (visit ids). Run docker compose + migrate script first.
# USE_PHYSICAL_SHARDS=false
# USE_PHYSICAL_SHARDS=true
# SHARD_0_HOST=localhost
# SHARD_0_PORT=5433
# SHARD_0_DB=gateguard_shard_0
# SHARD_0_USER=postgres
# SHARD_0_PASSWORD=shard_root
# SHARD_1_HOST=localhost
# SHARD_1_PORT=5434
# SHARD_1_DB=gateguard_shard_1
# SHARD_1_USER=postgres
# SHARD_1_PASSWORD=shard_root
# SHARD_2_HOST=localhost
# SHARD_2_PORT=5435
# SHARD_2_DB=gateguard_shard_2
# SHARD_2_USER=postgres
# SHARD_2_PASSWORD=shard_root

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - where the frontend runs
FRONTEND_URL=http://localhost:5173

# SMTP (for OTP / security emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=GateGuard <your-gmail@gmail.com>

# Auth security controls
OTP_EXPIRES_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Audit log file path (relative to backend root)
AUDIT_LOG_PATH=logs/audit.log
